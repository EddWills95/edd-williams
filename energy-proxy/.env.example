# Base URL of the Home Assistant instance (no trailing slash)
HA_URL=https://ha.your-url.com

# Long-lived access token for a DEDICATED, RESTRICTED Home Assistant user —
# not the main admin token. This token only needs read access to the six
# entities listed in server.js's ENTITIES map.
HA_TOKEN=replace-with-a-restricted-long-lived-access-token

PORT=3001

# How long a successful Home Assistant fetch is cached before the next
# request triggers a fresh one. Keep this well above "instant" — there's no
# reason to hit Home Assistant more often than the numbers meaningfully
# change, and it keeps this endpoint cheap for anyone hammering it.
CACHE_TTL_SECONDS=600

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://edd-williams.com,http://localhost:3000

# Optional extra fields. Leave unset to omit the field from the response.
# Only point these at sensors that are safe to publish (power/energy numbers,
# nothing that reveals presence, location or security state).
# HA_ENTITY_SOLAR_POWER=sensor.your_solar_power
# HA_ENTITY_HOUSE_POWER=sensor.your_house_consumption_power
# HA_ENTITY_GRID_POWER=sensor.your_grid_power
# HA_ENTITY_SAVINGS_TODAY=sensor.your_battery_savings_today

# Sign convention of HA_ENTITY_GRID_POWER: import-positive (default) or export-positive.
# HA_GRID_POWER_SIGN=import-positive

# Build stats (Claude Code token and git line/commit totals pushed from the Mac by
# scripts/build-stats). Leave BUILD_STATS_TOKEN unset to disable. The Mac job reads the same
# value from its Keychain (service "build-stats-token").
# Generate with: openssl rand -hex 32. This only authorises POSTing stats, nothing else.
# BUILD_STATS_TOKEN=replace-with-a-long-random-secret
# BUILD_STATS_DB=/data/build-stats.db
# BUILD_STATS_TZ=Europe/London
