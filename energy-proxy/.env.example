# Base URL of the Home Assistant instance (no trailing slash)
HA_URL=https://ha.your-url.com

# Long-lived access token for a DEDICATED, RESTRICTED Home Assistant user —
# not the main admin token. This token only needs read access to the six
# entities listed in server.js's ENTITIES map.
HA_TOKEN=replace-with-a-restricted-long-lived-access-token

PORT=3001

# How long a successful Home Assistant fetch is cached before the next
# request triggers a fresh one. Keep this well above "instant" — there's no
# reason to hit Home Assistant more often than the numbers meaningfully
# change, and it keeps this endpoint cheap for anyone hammering it.
CACHE_TTL_SECONDS=600

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://edd-williams.com,http://localhost:3000
